# Dependencies
node_modules/
.pnpm-store/

# npm artefacts (le projet est en pnpm — le lockfile est pnpm-lock.yaml)
package-lock.json
yarn.lock

# Build outputs
.next/
out/
dist/
build/
.turbo/

# Env
.env
.env.local
.env.*.local
.env.bak*
!.env.example

# Config MCP locale (pointe vers un projet Supabase personnel)
.mcp.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI
.supabase/
supabase/.branches/
supabase/.temp/

# Drop folder pour les sources d'assets (photos brutes, etc.) — les versions
# optimisées sont versionnées dans `packages/brand/assets/` après traitement.
/assets/

# Garde-fou : `eas-cli` et `expo` créent un `eas.json` / `app.json` à la
# racine quand on lance la commande depuis le mauvais répertoire. Les vrais
# fichiers vivent dans `apps/mobile/`. On ignore ceux du root pour éviter
# qu'ils soient commités par erreur (mauvais projectId / mauvais bundleId).
/eas.json
/app.json

# Artefacts de build mobile (`eas build --local` produit des IPA/TAR.GZ
# de plusieurs Mo, à NE PAS commiter — passer par EAS / TestFlight / un
# storage externe pour les distribuer).
*.ipa
*.tar.gz
apps/mobile/ios/
apps/mobile/android/

# Clés de signature et de soumission aux stores.
#
# Le plan nominal est de ne PAS avoir ces fichiers sur disque : ils vivent
# côté EAS, déposés une fois par `eas credentials`, et `eas submit` les
# utilise sans qu'aucune clé ne transite par le dépôt. Ces règles sont un
# filet, pour le jour où l'un d'eux sera téléchargé dans un coin du projet.
#
# Une clé d'API App Store Connect ou un compte de service Google commité,
# c'est un accès en écriture à la fiche du store : à traiter comme une
# fuite, pas comme une coquille.
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
google-service-account*.json
**/service-account*.json
