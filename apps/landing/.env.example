# ─── Projet Supabase landing (épisodes, votes, newsletter, équipe) ─────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://bento-pop.com

# Token partagé pour la revalidation on-demand depuis le BO admin.
# Server-only (jamais NEXT_PUBLIC_*). Si vide, l'endpoint /api/revalidate
# refuse toute requête (503).
REVALIDATE_TOKEN=

# ─── Projet Supabase mobile (« Mon Bento Pop ») ────────────────────────
# Projet DISTINCT du précédent. Sert la page publique /u/[pseudo], qui est
# la cible des liens partagés depuis l'app. Si ces deux variables sont
# vides, la page répond 404 et le reste du site fonctionne normalement.

# Inlinée au build : alimente `images.remotePatterns` (next.config.ts) et
# l'allowlist de `src/lib/images.ts`. Sans elle, les illustrations du
# catalogue contournent l'optimiseur next/image et tapent le Storage
# Supabase en taille d'origine à chaque visite.
NEXT_PUBLIC_MOBILE_SUPABASE_URL=

# Clé ANON, jamais la service-role : la landing est un site public et la
# RLS du projet mobile autorise déjà la lecture des bentos publiés.
# Pas de préfixe NEXT_PUBLIC_ : la page est rendue côté serveur, la clé n'a
# aucune raison de partir au navigateur.
MOBILE_SUPABASE_ANON_KEY=

# ─── Liens universels / App Links ──────────────────────────────────────
# Runtime uniquement : les deux routes .well-known sont `force-dynamic`,
# on peut donc changer ces valeurs sans redéployer.

# Team ID Apple (10 caractères), pour l'AASA.
APPLE_TEAM_ID=

# Empreintes SHA-256 du ou des certificats de signature Android, séparées
# par des virgules. Il en faut DEUX une fois l'app publiée : la clé
# d'upload (`eas credentials`) et la clé de signature d'application
# détenue par Google (Play Console → Intégrité de l'app). N'en déclarer
# qu'une fait retomber les liens sur le navigateur pour les
# installations venant du Play Store.
ANDROID_SHA256_FINGERPRINT=
