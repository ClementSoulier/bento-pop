{
  "expo": {
    "name": "Mon Bento Pop",
    "slug": "mon-bento-pop",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "bentopop",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f2a82a",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bentopop.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:bento-pop.com"
      ]
    },
    "android": {
      "package": "com.bentopop.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#f2a82a"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bento-pop.com",
              "pathPrefix": "/u/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#b5751a"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2a82a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 176,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "eecbef8a-0943-4bec-b592-59e4b5016e5f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eecbef8a-0943-4bec-b592-59e4b5016e5f"
    }
  }
}
