NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100

# Projet Supabase MOBILE (Mon Bento Pop). Server-side uniquement —
# la service-role key ne doit JAMAIS être exposée au navigateur.
MOBILE_SUPABASE_URL=
MOBILE_SUPABASE_SERVICE_ROLE_KEY=

# Revalidation on-demand de la landing depuis le BO. Server-only, sinon
# n'importe qui peut purger le cache. La même valeur doit être posée
# côté landing (REVALIDATE_TOKEN).
LANDING_URL=https://bento-pop.com
REVALIDATE_TOKEN=

# TMDb : token de lecture v4, utilisé par `catalog:images` pour les affiches
# de films et de séries (Wikimedia Commons n'en héberge aucune de
# réutilisable). Optionnel : à défaut, le script lit l'EXPO_PUBLIC_TMDB_TOKEN
# de apps/mobile/.env, qui est le même token.
TMDB_READ_TOKEN=<v4-read-access-token>

# Envoi de la newsletter par Resend Broadcasts (docs/NEWSLETTER-ENVOI.md).
# Runtime sur l'app back-office, jamais NEXT_PUBLIC_. Une clé « full access »
# propre au BO, distincte de RESEND_API_KEY (mails de modération), et
# l'identifiant du segment « Newsletter bento-pop.com ». Vides : les numéros
# s'écrivent, rien ne part.
RESEND_NEWSLETTER_API_KEY=
RESEND_NEWSLETTER_SEGMENT_ID=
