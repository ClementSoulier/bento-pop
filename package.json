{
  "name": "bento-pop",
  "private": true,
  "version": "0.0.0",
  "description": "Bento Pop — monorepo (apps + packages partagés).",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "dev:landing": "pnpm --filter @bento-pop/landing dev",
    "dev:admin": "pnpm --filter @bento-pop/admin dev",
    "dev:quiz": "pnpm --filter quiz-wheel dev",
    "dev:mobile": "pnpm --filter @bento-pop/mobile dev",
    "dev:mobile:web": "pnpm --filter @bento-pop/mobile dev:web",
    "build:landing": "pnpm --filter @bento-pop/landing build",
    "build:admin": "pnpm --filter @bento-pop/admin build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@types/react": "~19.2.18",
      "@types/react-dom": "~19.2.4"
    }
  }
}
